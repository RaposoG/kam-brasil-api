# Copie para .env. Em desenvolvimento, os defaults ja funcionam --  so o
# JWT_SECRET e obrigatorio.
#
# O Postgres NAO tem porta publicada: a API fala com ele pela rede interna do
# compose. Nao ha DATABASE_URL para voce montar; o compose ja a compoe.

# ---------- Obrigatorio ----------
# Minimo 32 caracteres. Gere:  openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-32-bytes-aleatorios

# Endereco publico do servidor de jogo: o que vai para a lista e para onde os
# jogadores discam. IP do VPS, ou um hostname que resolva para ele.
#
# Nao da para inferir: o servidor roda em container e o anuncio chega de um IP
# interno do Docker. Sem isto, a lista mandaria todo mundo conectar em si mesmo.
#
# UM valor para os DOIS servidores (casual e ranqueada), e esta certo assim: os
# dois rodam na mesma maquina, no mesmo IP publico. O que os distingue e a PORTA,
# que cada um manda no proprio anuncio -- a identidade de um servidor na lista e
# o par (ip, port).
GAME_SERVER_PUBLIC_ADDRESS=

# ---------- Producao ----------
# Senha do banco. O default so e aceitavel porque o Postgres nao e alcancavel
# de fora da rede do compose. Em producao, defina uma.
# POSTGRES_PASSWORD=

# Necessario para publicar releases (POST /client/releases). Vazio desabilita a
# rota, que e o padrao seguro. Gere:  openssl rand -hex 32
# ADMIN_TOKEN=

# E-mails com acesso ao painel administrativo (/admin/*), separados por virgula.
#
# O papel vem daqui e nao de um UPDATE no banco: conceder e revogar acesso passa
# a ser uma mudanca versionada no deploy, auditavel, em vez de um SQL rodado na
# mao e esquecido. A conta precisa existir -- o admin se registra pelo launcher
# como qualquer jogador, e o e-mail casando aqui e o que o promove.
#
# Vale no registro e a cada login. Tirar um e-mail daqui revoga o painel no
# proximo login dele; se a revogacao for urgente, revogue as sessoes da conta.
#
# VAZIO = ninguem e admin e o painel inteiro responde 403.
# ADMIN_EMAILS=tano.tano12377@gmail.com

# ---------- Opcionais ----------
# Porta publicada da API no host.
# API_PORT=3000

# Validade da sessao emitida no login.
# SESSION_TTL_DAYS=30

# Validade do ticket que o launcher entrega ao jogo. Curto porque passa por
# arquivo temporario, mas nao curto demais: o cliente reenvia a mesma credencial
# ao reconectar depois de uma queda.
# PLAY_TICKET_TTL_MINUTES=720

# Mensagem exibida na aba multiplayer do jogo.
# MOTD=Bem-vindo ao Kam Brasil!

# ---------- Ranqueada ----------
# LIGADA POR PADRAO. Nao ha nada a configurar aqui para ela funcionar.
#
# false desliga fila, pareamento e tempo real. Historico, replay e perfil seguem
# de pe: sao leitura do que ja aconteceu.
# RANKED_ENABLED=false

# Segredo compartilhado das rotas internas (/internal/ranked/*): a API o exige e
# o servidor dedicado o manda na querystring. UMA variavel para os dois lados de
# proposito -- preencher so um lado produz 403 a cada 3 segundos, em silencio.
#
# VAZIO NAO DESLIGA MAIS NADA: a API sorteia 32 bytes na primeira subida e grava
# em RANKED_SECRET_FILE (o compose ja aponta para um volume compartilhado), e o
# entrypoint do gameserver le o mesmo arquivo. Preencher aqui sobrepoe os dois
# lados -- util para girar o segredo sem apagar volume.  openssl rand -hex 32
#
# Nao reaproveitamos o JWT_SECRET: este segredo viaja na querystring, e
# querystring entra em log de acesso. Vazado, custa partidas falsas; o JWT
# vazado custa todas as contas.
# RANKED_INTERNAL_SECRET=

# CRCs de executavel aceitos em partida ranqueada, separados por virgula.
# VAZIO = aceita qualquer build. E obstaculo, nao seguranca: um cliente
# modificado mente o CRC. Serve para pegar build divergente na comunidade, que e
# a causa real de desync neste fork.
# RANKED_ALLOWED_EXE_CRCS=

# Bloco de salas do servidor dedicado reservado para o ranqueado. O protocolo do
# KaM nao cria sala por nome -- sala e indice --, entao a API e dona da alocacao.
# O padrao e a metade de cima do MAX_ROOMS=16: as salas 0-7 seguem livres para
# partida casual. Mexer aqui exige mexer no MAX_ROOMS junto.
# RANKED_ROOM_FIRST=8
# RANKED_ROOM_COUNT=8

# Intervalo do laco que pareia a fila ranqueada, reserva as salas sorteadas e
# cobra os turnos de ban vencidos. 0 desliga o laco neste processo (script,
# migracao, segundo no) -- as rotas continuam respondendo, so ninguem e pareado.
# RANKED_TICK_MS=3000

# Prazo de cada turno no lobby de bans. Estourou, o sistema bane pelo time que
# nao votou: um jogador ausente nao pode travar a partida dos outros sete.
# RANKED_BAN_TURNO_SEG=25

# Atras de nginx/Cloudflare precisa ser true para o log e o rate-limit verem o
# IP real do jogador. Os dois allowlists abaixo NAO dependem disto: eles comparam
# o endereco do socket, que o cliente nao consegue forjar (ver api/src/peer-ip.ts).
# TRUST_PROXY=true

# IPs autorizados a anunciar servidor de jogo (separados por virgula).
# O jogo nao envia credencial no serveradd.php -- os parametros sao fixos no
# Pascal --, entao filtrar pela origem e a unica forma de garantir que so os
# nossos servidores aparecam.
#
# VAZIO RECUSA TODO MUNDO em producao (em desenvolvimento continua aberto).
# Antes vazio aceitava qualquer origem, e o preco de errar a variavel era a
# lista de servidores sequestrada. Cuidado com valores que PARECEM preenchidos e
# viram lista vazia: " " (so espaco) e "," -- vale para o que estiver escrito no
# docker-compose.yml, que e de onde este valor sai agora.
#
# Aceita IP exato OU NOME DE SERVICO do compose. Em producao valem os nomes --
# `gameserver,gameserver-ranked` --, porque desde que os gameservers sairam de
# dentro da API eles tem IP dinamico. Quem resolve o nome e o DNS embutido do
# Docker, que so conhece os servicos deste projeto: ninguem na internet faz
# `gameserver` apontar para a maquina dele.
#
# NAO existe suporte a CIDR: escrever 172.16.0.0/12 nao libera faixa nenhuma, so
# cria uma entrada que nunca casa -- e ainda bem, porque o Traefik tambem e um
# container em faixa privada, e liberar a faixa deixaria passar a internet.
#
# Nome que nao resolve FECHA, nao abre: sem nada resolvido, anuncio e
# /auth/verify respondem 403 e o boot loga o aviso.
#
# NAO DEFINA ESTA VARIAVEL AQUI (nem no painel do Dokploy). O valor esta escrito
# literalmente no docker-compose.yml, ao lado dos nomes dos servicos que ele
# define -- os dois so fazem sentido juntos. Se voce definir aqui, NAO tera
# efeito: nao ha `${...}` no compose para esta variavel.
# ANNOUNCE_ALLOWED_IPS=

# Quem pode verificar ticket (GET /auth/verify) e chamar /internal/ranked/*.
# Mesma regra do de cima: nomes de servico, fixo no docker-compose.yml.
#
# O ticket trafega em claro na query -- limitacao do cliente HTTP do Pascal --,
# entao o trafego nao pode sair da maquina: a rede do compose e uma bridge local.
# VERIFY_ALLOWED_IPS=

# ---------- Servidores de jogo ----------
# Sao DOIS, e cada um roda no proprio container, na propria porta:
#
#   gameserver         casual   porta SERVER_PORT         sem ranqueada nenhuma
#   gameserver-ranked  ranqueada porta RANKED_SERVER_PORT so ranqueada
#
# Os dois ficam na rede `default` do compose e alcancam a API pelo nome do
# servico (`http://api:3000`). Nenhum dos dois divide mais o namespace de rede da
# API -- deploy da API nao derruba mais partida em andamento.
#
# Nao ha rede nem subnet declarada: o Dokploy reescreve a chave `networks:` ao
# injetar a rede do Traefik, e declarar rede nossa seria apostar que ele
# acrescenta em vez de substituir. Ver o comentario no topo do
# docker-compose.yml.

# --- Casual (o de sempre) ---
# Nome exibido na lista de servidores do jogo.
# SERVER_NAME=Kam Brasil

# Porta TCP do jogo. Publicada direto no host: e TCP cru, o Traefik nao roteia.
# Mantenha a de sempre: quem tem o servidor salvo nos favoritos do jogo conecta
# por ela.
# SERVER_PORT=56789

# Salas simultaneas e mensagem ao entrar.
# MAX_ROOMS=16
# WELCOME_MESSAGE=

# --- Ranqueada ---
# Porta do servidor de ranqueada. UMA variavel para os dois lados: e a porta que
# o container publica E o que a API usa (RANKED_SERVER_PORT) para saber qual dos
# dois anuncios e o do ranqueado. Impossivel dessincronizar.
#
# Sem isto a API pegaria "o dedicado que anunciou por ultimo", ou seja, sorteio:
# metade das partidas ranqueadas cairia no servidor casual.
# RANKED_SERVER_PORT=56790

# O servidor de ranqueada TAMBEM aparece na lista publica -- e obrigatorio, e do
# anuncio vivo dele que a API tira o endereco para onde manda os pareados. Por
# isso o nome padrao ja avisa o que ele e.
# RANKED_SERVER_NAME=Kam Brasil Ranqueada
# RANKED_WELCOME_MESSAGE=

# Salas do servidor de ranqueada. Tem que cobrir RANKED_ROOM_FIRST +
# RANKED_ROOM_COUNT (8 + 8 = 16 no padrao): indice fora do maximo e sala que nao
# existe.
# RANKED_MAX_ROOMS=16

# Commit do repositorio do jogo de onde o servidor e compilado. Uma tag deixa o
# build reproduzivel.
# GAME_REF=master

# 0 desliga a exigencia de ticket -- qualquer cliente entra com o nickname que
# quiser. So para depurar.
# REQUIRE_AUTH=1
