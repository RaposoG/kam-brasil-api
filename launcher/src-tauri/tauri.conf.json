{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kam Brasil",
  "version": "1.0.2",
  "identifier": "br.com.kambrasil.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kam Brasil",
        "width": 900,
        "height": 620,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3000 https://kam-api.melhorzin.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RaposoG/kam-brasil-api/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMjg5RTYyMkFCOTkzRTgKUldUb2s3a3FZcDRvckIyQmNkTDhWbzcrbkdjRGFWTWQyUTc4MHp6L2ZHZTFrY0JRN2UxY3owZUkK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Kam Brasil",
    "copyright": "Kam Brasil — comunidade brasileira de Knights and Merchants",
    "shortDescription": "Launcher do Kam Brasil",
    "longDescription": "Instala, atualiza e abre o Kam Brasil. Requer o Knights and Merchants: The Peasants Rebellion original instalado.",
    "category": "Game",
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
